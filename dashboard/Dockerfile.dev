# syntax=docker/dockerfile:1

# Development/compose image running the Vite dev server with HMR. In
# production the dashboard is a static build (`npm run build`) uploaded to S3
# and served by CloudFront - see docs/aws-architecture.md - so there is
# deliberately no production Dockerfile here.

FROM docker.io/library/node:22-slim

WORKDIR /app

# Install deps as their own layer so source edits don't invalidate node_modules.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
